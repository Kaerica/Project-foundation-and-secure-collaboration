subscription_id       = "<YOUR_AZURE_SUBSCRIPTION_ID>"
location              = "eastus2"
environment           = "dev-eastus2"
vm_size               = "Standard_B1s"
github_runner_vm_size = "Standard_B2s"
admin_username        = "azureuser"
ssh_public_key        = "<YOUR_SSH_PUBLIC_KEY>"
postgresql_server_name    = "inventory-dev-unique"
postgresql_admin_username = "pgadmin"
postgresql_admin_password = "<GENERATE_A_STRONG_UNIQUE_PASSWORD>"
postgresql_app_password   = "<GENERATE_A_DIFFERENT_STRONG_UNIQUE_PASSWORD>"
container_registry_name   = "inventorydevunique"